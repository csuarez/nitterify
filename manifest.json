{
  "manifest_version": 3,
  "name": "Nitterify",
  "version": "1.0.0",
  "description": "Automatically redirects X/Twitter URLs to a Nitter instance of your choice for anonymous, login-free browsing.",
  "browser_specific_settings": {
    "gecko": {
      "id": "nitterify@csuarez",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["declarativeNetRequestWithHostAccess", "storage"],
  "host_permissions": [
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*"
  ],
  "background": {
    "scripts": ["rules.js", "background.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon-off.svg",
    "default_title": "Nitterify"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
